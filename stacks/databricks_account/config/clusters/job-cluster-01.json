{
  "cluster_name": "job-cluster-01",
  "spark_version": "15.4.x-scala2.12",
  "node_type_id": "Standard_DS4_v2",
  "driver_node_type_id": "Standard_DS4_v2",
  "autoscale": {
    "min_workers": 1,
    "max_workers": 2
  },
  "autotermination_minutes": 10,
  "enable_elastic_disk": true,
  "enable_local_disk_encryption": false,
  "data_security_mode": "USER_ISOLATION",
  "runtime_engine": "STANDARD",
  "spark_env_vars": {
    "PYSPARK_PYTHON": "/databricks_account/python3/bin/python3"
  },
  "spark_conf": {
    "spark.databricks_account.delta.preview.enabled": "true",
    "spark.databricks_account.sql.initial.catalog.name": ""
  }
}
