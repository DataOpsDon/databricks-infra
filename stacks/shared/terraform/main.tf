// ---------------------------------------------------------------------------------------------------------------------
// SHARED Stack - shared services (jump box and private CI runners)
// This Terraform configuration provisions resources for the shared deployment.
//
// Notes:
// - Naming is centralised via the `naming` module to ensure consistent resource names across environments.
// - Only Azure Verified Modules (AVM) are used: no `resource` blocks and no custom modules.
// - The shared VNet is peered to the hub and the spoke. The hub Bastion (Standard SKU) reaches the jump box over peering.

// Module: naming
// Purpose: Centralised naming standards for resources (project, environment, location short code).
module "naming" {
  source  = "Azure/naming/azurerm"
  version = "0.4.4"

  suffix = [var.project, var.environment, var.location_short]
}

// Module: resource_group
// Purpose: Creates the shared resource group to contain all resources in this stack.
module "resource_group" {
  source           = "Azure/avm-res-resources-resourcegroup/azurerm"
  version          = "0.2.1"
  enable_telemetry = var.enable_telemetry
  location         = var.location
  name             = module.naming.resource_group.name
  tags             = var.tags
}

// Module: nat_gateway
// Purpose: Outbound internet for the jump box subnet. Subnets have default outbound access disabled, so without this
// the VM cannot reach the internet (Windows Update, downloads).
module "nat_gateway" {
  source           = "Azure/avm-res-network-natgateway/azurerm"
  version          = "0.4.0"
  enable_telemetry = var.enable_telemetry
  location         = var.location
  parent_id        = module.resource_group.resource_id
  name             = module.naming.nat_gateway.name
  tags             = var.tags

  public_ips = {
    primary = {
      name = "${module.naming.public_ip.slug}-natgw-${local.name_suffix}"
    }
  }
}

// Module: virtual_network
// Purpose: Shared virtual network (/22) with a jump box subnet that uses the NAT gateway for outbound access. Peered to
// the hub and the spoke in both directions (reverse peerings are created in their VNets' resource groups).
module "virtual_network" {
  source           = "Azure/avm-res-network-virtualnetwork/azurerm"
  version          = "0.23.0"
  enable_telemetry = var.enable_telemetry
  location         = var.location
  parent_id        = module.resource_group.resource_id
  name             = module.naming.virtual_network.name
  address_space    = [var.vnet_address_space]
  dns_servers      = length(var.dns_servers) > 0 ? { dns_servers = var.dns_servers } : null
  tags             = var.tags

  subnets = {
    jumpbox = {
      name             = local.subnet_names.jumpbox
      address_prefixes = [local.subnet_prefixes.jumpbox]
      nat_gateway = {
        id = module.nat_gateway.resource_id
      }
    }
    sql = {
      name             = local.subnet_names.sql
      address_prefixes = [local.subnet_prefixes.sql]
      nat_gateway = {
        id = module.nat_gateway.resource_id
      }
    }
  }

  peerings = {
    shared_to_hub = {
      name                                 = "peer-${local.name_suffix}-to-hub"
      remote_virtual_network_resource_id   = var.hub_virtual_network_id
      allow_forwarded_traffic              = true
      allow_virtual_network_access         = true
      create_reverse_peering               = true
      reverse_name                         = "peer-hub-to-${local.name_suffix}"
      reverse_allow_forwarded_traffic      = true
      reverse_allow_virtual_network_access = true
    }
    shared_to_spoke = {
      name                                 = "peer-${local.name_suffix}-to-spoke"
      remote_virtual_network_resource_id   = var.spoke_virtual_network_id
      allow_forwarded_traffic              = true
      allow_virtual_network_access         = true
      create_reverse_peering               = true
      reverse_name                         = "peer-spoke-to-${local.name_suffix}"
      reverse_allow_forwarded_traffic      = true
      reverse_allow_virtual_network_access = true
    }
  }
}

// Module: jumpbox
// Purpose: Windows VM in the shared VNet, used through Azure Bastion (Standard SKU, in the hub) to reach the private Databricks
// workspaces and the data lake. No public IP. The admin password is generated by the module and kept in Terraform
// state (see the sensitive output `jumpbox_admin_password`).
module "jumpbox" {
  source              = "Azure/avm-res-compute-virtualmachine/azurerm"
  version             = "0.21.0"
  enable_telemetry    = var.enable_telemetry
  location            = var.location
  resource_group_name = module.resource_group.name
  name                = module.naming.virtual_machine.name
  computer_name       = var.jumpbox_computer_name
  os_type             = "Windows"
  sku_size            = var.jumpbox_sku_size
  zone                = var.jumpbox_zone
  tags                = var.tags

  encryption_at_host_enabled = var.jumpbox_encryption_at_host_enabled

  os_disk = {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }

  # The Azure Edition image is hotpatch enabled, which requires platform-orchestrated patching.
  hotpatching_enabled   = true
  patch_mode            = "AutomaticByPlatform"
  patch_assessment_mode = "AutomaticByPlatform"

  source_image_reference = {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2025-datacenter-azure-edition"
    version   = "latest"
  }

  network_interfaces = {
    primary = {
      name = "${module.naming.network_interface.slug}-jumpbox-${local.name_suffix}"
      ip_configurations = {
        primary = {
          name                          = "ipconfig1"
          private_ip_subnet_resource_id = module.virtual_network.subnets["jumpbox"].resource_id
        }
      }
    }
  }
}

// Module: sql_vm
// Purpose: Small Windows VM running SQL Server, built from the Microsoft SQL Server marketplace image (SQL is pre-installed).
// No public IP: reach it through Azure Bastion in the hub. OS disk is Standard SSD. The admin password is generated by the
// module and kept in Terraform state (see the sensitive output `sql_vm_admin_password`).
module "sql_vm" {
  source              = "Azure/avm-res-compute-virtualmachine/azurerm"
  version             = "0.21.0"
  enable_telemetry    = var.enable_telemetry
  location            = var.location
  resource_group_name = module.resource_group.name
  name                = "${module.naming.virtual_machine.slug}-sql-${local.name_suffix}"
  computer_name       = var.sql_vm_computer_name
  os_type             = "Windows"
  sku_size            = var.sql_vm_sku_size
  zone                = var.jumpbox_zone
  tags                = var.tags

  encryption_at_host_enabled = var.jumpbox_encryption_at_host_enabled

  os_disk = {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }

  source_image_reference = {
    publisher = "MicrosoftSQLServer"
    offer     = var.sql_image_offer
    sku       = var.sql_image_sku
    version   = "latest"
  }

  network_interfaces = {
    primary = {
      name = "${module.naming.network_interface.slug}-sql-${local.name_suffix}"
      ip_configurations = {
        primary = {
          name                          = "ipconfig1"
          private_ip_subnet_resource_id = module.virtual_network.subnets["sql"].resource_id
        }
      }
    }
  }
}

// Module: sql_virtual_machine
// Purpose: Registers the SQL Server VM with the SQL IaaS Agent extension (portal SQL management, patching and backup
// features). The SQL virtual machine resource must have the same name as the VM.
module "sql_virtual_machine" {
  source                      = "Azure/avm-res-sqlvirtualmachine-sqlvirtualmachine/azurerm"
  version                     = "0.1.0"
  enable_telemetry            = var.enable_telemetry
  location                    = var.location
  resource_group_name         = module.resource_group.name
  name                        = module.sql_vm.name
  virtual_machine_resource_id = module.sql_vm.resource_id
  sql_management              = "Full"
  sql_server_license_type     = "PAYG"
  tags                        = var.tags
}
