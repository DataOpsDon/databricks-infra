// ---------------------------------------------------------------------------------------------------------------------
// SHARED Stack - shared services (jump box and private CI runners)
// This Terraform configuration provisions resources for the shared deployment.
//
// Notes:
// - Naming is centralised via the `naming` module to ensure consistent resource names across environments.
// - Only Azure Verified Modules (AVM) are used: no `resource` blocks and no custom modules.
// - The VM and the runners sit in subnets of the hub VNet (created by the hub stack, passed in as variables), because
//   Bastion Developer only reaches VMs in its own VNet and the runners need the hub's peering to reach the spokes.

// Module: naming
// Purpose: Centralised naming standards for resources (project, environment, location short code).
module "naming" {
  source  = "Azure/naming/azurerm"
  version = "0.4.4"

  suffix = [var.project, var.environment, var.location_short]
}

// Module: resource_group
// Purpose: Creates the shared resource group to contain all resources in this stack.
module "resource_group" {
  source           = "Azure/avm-res-resources-resourcegroup/azurerm"
  version          = "0.2.1"
  enable_telemetry = var.enable_telemetry
  location         = var.location
  name             = module.naming.resource_group.name
  tags             = var.tags
}

// Module: jumpbox
// Purpose: Windows VM used through Azure Bastion (Developer SKU, in the hub) to reach the private Databricks
// workspaces and the data lake. No public IP. The admin password is generated by the module and kept in Terraform
// state (see the sensitive output `jumpbox_admin_password`).
module "jumpbox" {
  source              = "Azure/avm-res-compute-virtualmachine/azurerm"
  version             = "0.21.0"
  enable_telemetry    = var.enable_telemetry
  location            = var.location
  resource_group_name = module.resource_group.name
  name                = module.naming.virtual_machine.name
  computer_name       = var.jumpbox_computer_name
  os_type             = "Windows"
  sku_size            = var.jumpbox_sku_size
  zone                = var.jumpbox_zone
  tags                = var.tags

  encryption_at_host_enabled = var.jumpbox_encryption_at_host_enabled

  source_image_reference = {
    publisher = "MicrosoftWindowsServer"
    offer     = "WindowsServer"
    sku       = "2022-datacenter-azure-edition"
    version   = "latest"
  }

  network_interfaces = {
    primary = {
      name = "${module.naming.network_interface.slug}-jumpbox-${local.name_suffix}"
      ip_configurations = {
        primary = {
          name                          = "ipconfig1"
          private_ip_subnet_resource_id = var.jumpbox_subnet_id
        }
      }
    }
  }
}

// Module: dev_center
// Purpose: Dev Center that Managed DevOps Pools attach to through a Dev Center project.
module "dev_center" {
  source              = "Azure/avm-res-devcenter-devcenter/azurerm"
  version             = "0.2.0"
  enable_telemetry    = var.enable_telemetry
  location            = var.location
  resource_group_name = module.resource_group.name
  dev_center_name     = "dc-${local.name_suffix}"
  tags                = var.tags
}

// Module: managed_devops_pool
// Purpose: Managed DevOps Pool of private runners, injected into the delegated hub subnet (outbound through the hub NAT
// gateway, private reach to the spokes over peering). It attaches to a Dev Center project, which has no AVM module,
// so the project ID is an input (var.dev_center_project_resource_id).
module "managed_devops_pool" {
  source                         = "Azure/avm-res-devopsinfrastructure-pool/azurerm"
  version                        = "0.3.2"
  enable_telemetry               = var.enable_telemetry
  location                       = var.location
  resource_group_name            = module.resource_group.name
  name                           = "mdp-${local.name_suffix}"
  dev_center_project_resource_id = var.dev_center_project_resource_id
  subnet_id                      = var.devops_pool_subnet_id
  maximum_concurrency            = var.devops_pool_max_concurrency
  fabric_profile_sku_name        = var.devops_pool_sku_name
  tags                           = var.tags

  version_control_system_type              = var.version_control_system_type
  version_control_system_organization_name = var.version_control_system_organization_name
}
